{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Tiinex: npm install",
      "type": "shell",
      "command": "node",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true,
        "showReuseMessage": false
      },
      "args": [
        "scripts/core-mode.mjs",
        "install"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "label": "Tiinex: Pack Core locally",
      "type": "shell",
      "command": "npm",
      "args": [
        "pack",
        "--dry-run",
        "${workspaceFolder}/../core"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true,
        "showReuseMessage": false
      }
    },
    {
      "label": "Tiinex: Use local Core",
      "type": "shell",
      "command": "node",
      "args": [
        "scripts/core-mode.mjs",
        "local"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true,
        "showReuseMessage": false
      }
    },
    {
      "label": "Tiinex: Switch Core to Latest",
      "type": "shell",
      "command": "node",
      "args": [
        "scripts/core-mode.mjs",
        "published"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true,
        "showReuseMessage": false
      }
    },
    {
      "label": "Tiinex: Switch all to Local",
      "type": "shell",
      "command": "node",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true,
        "showReuseMessage": false
      },
      "args": [
        "scripts/core-mode.mjs",
        "all-local"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "label": "Tiinex: Switch all to Latest",
      "type": "shell",
      "command": "node",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true,
        "showReuseMessage": false
      },
      "args": [
        "scripts/core-mode.mjs",
        "all-latest"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "label": "Tiinex: Link this checkout",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "scripts/ensure-windows-main-host-dev-extension-link.ps1"
      ],
      "dependsOrder": "sequence",
      "dependsOn": [
        "Tiinex: npm install"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true,
        "showReuseMessage": false
      }
    },
    {
      "label": "Tiinex: Build linked extension",
      "type": "npm",
      "script": "dev:build",
      "dependsOrder": "sequence",
      "dependsOn": [
        "Tiinex: npm install"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$tsc",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true,
        "showReuseMessage": false
      }
    },
    {
      "label": "Tiinex: Unlink this checkout",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "scripts/ensure-windows-main-host-dev-extension-link.ps1",
        "-Unlink"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true,
        "showReuseMessage": false
      }
    }
  ]
}
