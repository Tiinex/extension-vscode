{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Tiinex: npm install",
      "type": "shell",
      "command": "npm install",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true,
        "showReuseMessage": false
      }
    },
    {
      "label": "Tiinex: Pack Core locally",
      "type": "shell",
      "command": "npm",
      "args": [
        "pack",
        "--dry-run",
        "${workspaceFolder}/../core"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true,
        "showReuseMessage": false
      }
    },
    {
      "label": "Tiinex: Use local Core",
      "type": "shell",
      "command": "npm",
      "args": [
        "install",
        "--no-save",
        "--package-lock=false",
        "--install-links",
        "file:${workspaceFolder}/../core"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOrder": "sequence",
      "dependsOn": [
        "Tiinex: Pack Core locally"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true,
        "showReuseMessage": false
      }
    },
    {
      "label": "Tiinex: Switch Core to Latest",
      "type": "shell",
      "command": "npm",
      "args": [
        "install",
        "@tiinex/core@latest"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true,
        "showReuseMessage": false
      }
    },
    {
      "label": "Tiinex: Switch all to Local",
      "type": "shell",
      "command": "echo Tiinex local dependencies active.",
      "dependsOrder": "sequence",
      "dependsOn": [
        "Tiinex: Use local Core"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true,
        "showReuseMessage": false
      }
    },
    {
      "label": "Tiinex: Switch all to Latest",
      "type": "shell",
      "command": "echo Tiinex npm dependencies active.",
      "dependsOrder": "sequence",
      "dependsOn": [
        "Tiinex: Switch Core to Latest"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true,
        "showReuseMessage": false
      }
    },
    {
      "label": "Tiinex: Link this checkout",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "scripts/ensure-windows-main-host-dev-extension-link.ps1"
      ],
      "dependsOrder": "sequence",
      "dependsOn": [
        "Tiinex: npm install"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true,
        "showReuseMessage": false
      }
    },
    {
      "label": "Tiinex: Build linked extension",
      "type": "npm",
      "script": "dev:build",
      "dependsOrder": "sequence",
      "dependsOn": [
        "Tiinex: npm install"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$tsc",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true,
        "showReuseMessage": false
      }
    },
    {
      "label": "Tiinex: Unlink this checkout",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "scripts/ensure-windows-main-host-dev-extension-link.ps1",
        "-Unlink"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true,
        "showReuseMessage": false
      }
    },
    {
      "label": "Tiinex: commit message from staged artifacts",
      "type": "shell",
      "command": "node tools/tiinex-commit-message.mjs",
      "group": "none",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true,
        "showReuseMessage": false
      }
    }
  ]
}
