    "configuration": {
      "title": "Tiinex",
      "properties": {
        "tiinex.discovery.folder": {
          "type": "string",
          "default": "",
          "description": "Folder containing .handoff-package.zip carriers shown by Discovery. Blank means no discovery folder; expanding Discovery asks you to choose one."
        },
        "tiinex.discovery.autoRefresh": {
          "type": "boolean",
          "default": false,
          "description": "Automatically refresh the Discovery tree when .handoff-package.zip files change in the selected discovery folder. This never performs Receive/landing."
        },
        "tiinex.discovery.autoClearDiscovery": {
          "type": "string",
          "enum": [
            "no",
            "yes"
          ],
          "default": "no",
          "description": "Automatically clear old Discovery entries on startup before scanning the selected discovery folder. This only affects what Discovery shows, not Receive/landing."
        },
        "tiinex.discovery.latestToIncoming": {
          "type": "boolean",
          "default": false,
          "description": "When Discovery finds a new latest carrier, set that carrier as Incoming after qualification. This never performs Receive/landing."
        },
        "tiinex.guidedEntry.showBuiltInEntries": {
          "type": "boolean",
          "default": true,
          "description": "Show Core-native Entry definitions in Guided Entry. Disable to show only qualified Entry artifacts carried by the selected package plus Custom. This setting changes host presentation only; Core still owns Entry qualification."
        },
        "tiinex.nodePath": {
          "type": "string",
          "default": "",
          "description": "Optional Node executable override for Tiinex Tooling. Blank uses the current executable when it is Node; otherwise it uses node/node.exe from PATH."
        },
        "tiinex.landing.stage": {
          "type": "string",
          "enum": [
            "no",
            "yes"
          ],
          "default": "yes",
          "description": "After a successful explicit Incoming Workspace merge, stage safe landed changes. No leaves that landing unstaged; it does not disable later post-stage evaluation if the operator manually stages Tiinex material."
        },
        "tiinex.git.postStagePolicy": {
          "type": "string",
          "enum": [
            "do-nothing",
            "ask",
            "commit",
            "commit-push"
          ],
          "enumDescriptions": [
            "Do Nothing — leave staged changes staged; no Tiinex commit or push is initiated.",
            "Ask — after a stable staged Tiinex state passes the Git safety gates, ask once for that exact staged state: Commit creates the local commit, Commit + Push creates then publishes only that exact commit through the existing push-safety gates, and Cancel leaves staging unchanged.",
            "Commit — after a stable staged-state event, auto-commit only the exact staged selection when it contains Tiinex Markdown material and passes the Git safety gates; Tiinex qualification is not re-run here.",
            "Commit + Push — apply the same staged-selection Git safety gates and require an aligned upstream before committing; then push only the exact commit created by that same Tiinex operation."
          ],
          "default": "ask",
          "description": "Post-stage Git policy over a stable staged Tiinex selection. It is independent of tiinex.landing.stage, never performs Stage All, and does not re-run Tiinex qualification before ordinary commit/push."
        },
        "tiinex.outgoing.folder": {
          "type": "string",
          "default": "",
          "description": "Folder where Pack writes materialized Outgoing .handoff-package.zip carriers. Blank asks for a folder when Pack is used."
        },
        "tiinex.operator.party": {
          "type": "string",
          "default": "",
          "description": "User-profile Operator Party preference used only for host-local author defaults, recipient-scope preview and UI suggestions. Use Pick Operator Party. Empty means None; canonical values use Workspace::artifact-path; unknown::<display name> stores a named unknown Party. This setting does not grant Party/Role authority.",
          "pattern": "^(?:|unknown::[^\\r\\n]+|[^:\\r\\n]+::\\.topics/[^\\r\\n]+)$",
          "patternErrorMessage": "Use Pick Operator Party. Valid values are empty (None), unknown::<display name>, or workspace::.topics/<artifact path>."
        },
        "tiinex.incoming.autoShowPartyHandoff": {
          "type": "string",
          "enum": [
            "no",
            "ask",
            "yes"
          ],
          "default": "ask",
          "description": "When Incoming has qualified Handoff routes whose To falls within the Core-projected scope of tiinex.operator.party, optionally preview and reveal every matching actual Handoff. Manual unknown Parties match only their exact display label. This never grants Party/Role authority."
        },
        "tiinex.copilot.panelActions": {
          "type": "string",
          "enum": [
            "none",
            "pack-and-transport",
            "inspect-unpack-pack-and-transport"
          ],
          "enumDescriptions": [
            "No delegated Tiinex operator panel actions. Copilot may still create artifacts, ground and use the normal Core CLI.",
            "Allow agent-driven outgoing preview, packaging and transport preparation only.",
            "Also allow incoming inspection and unpacking into safe staging. Never grants Merge/Replace, Reject, delete, reset or source overwrite."
          ],
          "default": "none",
          "description": "Delegated VS Code Tiinex operator-panel actions for future Copilot native tools only. Does not restrict ordinary authoring, Core CLI, grounding, or human panel actions."
        }
      }
    },
    "views": {
      "tiinex": [
        {
          "id": "tiinex.discovery",
