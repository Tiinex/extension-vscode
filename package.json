  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node scripts/test-installed-core-fixture.mjs",
    "vsix": "npm run build && node scripts/package-vsix.mjs",
    "validate": "npm run typecheck && npm test && npm run test:package && npm run vsix && npm run test:authoring-boundaries",
    "dev:build": "tsc -p tsconfig.json",
    "dev:build:local": "node scripts/core-mode.mjs all-local && npm run dev:build",
    "dev:build:latest": "node scripts/core-mode.mjs all-latest && npm run dev:build",
    "dev:setup": "npm run dev:link",
    "dev:link": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/ensure-windows-main-host-dev-extension-link.ps1",
    "dev:unlink": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/ensure-windows-main-host-dev-extension-link.ps1 -Unlink",
    "test:package": "npm run build && node test/package-integration.mjs",
    "test:local-core": "node scripts/test-local-core.mjs",
    "test:extension-host": "node scripts/test-extension-host.mjs",
    "release:check": "npm run validate && npm run release:audit",
    "release:audit": "node scripts/release-check.mjs",
    "vscode:prepublish": "npm run build && npm run release:audit",
    "test:authoring-boundaries": "node test/authoringBoundaries.regression.cjs && node test/webviewSourceContext.regression.cjs && node test/nativeAgentDiscovery.regression.cjs && node test/nativeAgentRoleSync.regression.cjs && node test/skillPackaging.regression.mjs && node scripts/run-host-boundaries.mjs && node test/vsixReleaseBoundary.regression.mjs",
    "test:transition-roundtrip": "node test/transitionRoundtrip.integration.mjs",
    "vsix:release": "npm run build && node scripts/package-vsix-release.mjs",
    "test:packed-core-integration": "node scripts/test-packed-core-integration.mjs"
  },
  "dependencies": {
    "@tiinex/core": "^0.45.0"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/vscode": "1.95.0",
    "typescript": "5.7.2"
  },
