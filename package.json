    "tiinex",
    "handoff",
    "workspace",
    "continuity",
    "lineage",
    "transport",
    "git",
    "workflow"
  ],
  "homepage": "https://github.com/Tiinex/extension-vscode",
  "bugs": {
    "url": "https://github.com/Tiinex/extension-vscode/issues"
  },
  "pricing": "Free",
  "icon": "media/tiinex-marketplace.png",
  "galleryBanner": {
    "color": "#123a52",
    "theme": "dark"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Tiinex runs local Tooling, Git, and explicit Workspace mutation flows and therefore requires a trusted Workspace."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "Tiinex requires local filesystem, Node.js Tooling, Git repositories, and physical Handoff packages."
    }
  }
}
