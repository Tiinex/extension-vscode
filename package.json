{
  "name": "tiinex-vscode",
  "displayName": "Tiinex",
  "description": "Native Tiinex workflows for qualified Handoffs, Workspace carriers, Incoming/Outgoing review, Transport, and Git in VS Code.",
  "version": "0.1.7",
  "publisher": "tiinex",
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:.topics",
    "onStartupFinished",
    "onLanguage:markdown"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languageModelTools": [
      {
        "name": "tiinex_inspectCapabilities",
        "displayName": "Inspect Tiinex Capabilities",
        "modelDescription": "Read-only discovery of Core-qualified Tiinex operation names, intent, safety and contract IDs. Use to learn what Tiinex can do before proposing any action; discovery does not grant execution or Role authorization.",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "inspectTiinexCapabilities",
        "inputSchema": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "maxLength": 120,
              "description": "Optional short name or intent filter for the Core operation catalog."
            }
          },
          "additionalProperties": false
        }
      }
    ],
    "chatSkills": [
      {
        "path": "./skills/tiinex-discovery/SKILL.md"
      }
    ],
