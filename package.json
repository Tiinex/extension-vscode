{
  "name": "tiinex-vscode",
  "displayName": "Tiinex",
  "description": "Thin native VS Code operator bridge for qualified Tiinex validation, artifact-first Handoff authoring, package construction, Workspace landing, and Git workflow.",
  "version": "0.1.7",
  "publisher": "tiinex",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:tiinex.landHandoffPackage",
    "onCommand:tiinex.generateCommitMessage",
    "onCommand:tiinex.stageCommitPush",
    "onCommand:tiinex.selectHandoffInbox",
    "workspaceContains:.topics",
    "onCommand:tiinex.createHandoff",
    "onCommand:tiinex.buildHandoffPackage",
    "onStartupFinished",
    "onLanguage:markdown",
    "onCommand:tiinex.openOperator",
    "onCommand:tiinex.refreshDiagnostics",
    "onCommand:tiinex.showProblems",
    "onCommand:tiinex.createHandoffFromArtifact",
    "onView:tiinex.operator"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "tiinex.landHandoffPackage",
        "title": "Tiinex: Receive Handoff Package"
      },
      {
        "command": "tiinex.generateCommitMessage",
        "title": "Tiinex: Generate Tiinex Commit Message"
      },
      {
        "command": "tiinex.stageCommitPush",
        "title": "Tiinex: Stage, Commit & Push with Tiinex"
      },
      {
        "command": "tiinex.selectHandoffInbox",
        "title": "Tiinex: Select Handoff Inbox"
      },
      {
        "command": "tiinex.createHandoff",
        "title": "Tiinex: Prepare Return Handoff"
      },
      {
        "command": "tiinex.buildHandoffPackage",
        "title": "Tiinex: Build Return Package"
      },
      {
        "command": "tiinex.openOperator",
        "title": "Tiinex: Open Receive / Review / Return"
      },
      {
        "command": "tiinex.refreshDiagnostics",
        "title": "Tiinex: Refresh Validation"
      },
      {
        "command": "tiinex.showProblems",
        "title": "Tiinex: Show Validation Problems"
      },
      {
        "command": "tiinex.createHandoffFromArtifact",
        "title": "Tiinex: Create Handoff from This Artifact",
        "enablement": "tiinex.activeArtifactCanCreateHandoff"
      }
    ],
    "configuration": {
      "title": "Tiinex",
      "properties": {
        "tiinex.handoffInbox.path": {
          "type": "string",
          "default": "",
          "description": "Global inbox override used by Tiinex Handoff discovery. Blank uses ~/Downloads/Tiinex Inbox; manual Receive can still select any package directly."
        },
        "tiinex.nodePath": {
          "type": "string",
          "default": "",
          "description": "Explicit Node executable for package-declared bootstrap and installed @tiinex/core Tooling. Blank uses the VS Code/Electron executable in Node mode; repository-local helpers keep their own repository boundary."
        },
        "tiinex.operator.role": {
          "type": "string",
          "default": "",
          "description": "Presentation-only operator role label used after Receive to prefer qualified Handoffs whose From or To label matches (for example Sigma). Blank or no match shows all qualified Handoffs. This setting does not grant Role authority."
        },
        "tiinex.handoff.discovery": {
          "type": "string",
          "enum": [
            "manual",
            "auto"
          ],
          "default": "manual",
          "description": "Receive discovery mode. Manual never watches or scans historical inbox files; Auto watches only stable completed .handoff-package.zip files observed after the current watcher session starts."
        },
        "tiinex.landing.commit": {
          "type": "string",
          "enum": [
            "no",
            "ask",
            "yes"
          ],
          "default": "no",
          "description": "After each qualified Receive, stage every explicitly selected landed repository while excluding the pre-landing ignored set. Yes commits with a trusted deterministic landing message; Ask offers the choice; No leaves changes staged and offers that message for copy/use."
        },
        "tiinex.landing.push": {
          "type": "string",
          "enum": [
            "no",
            "ask",
            "yes"
          ],
          "default": "no",
          "description": "Push only an exact commit created by the same Receive invocation, and only when auto-commit was approved immediately before it and the pre-landing upstream was aligned and unchanged. Manual commits are never auto-pushed."
        },
        "tiinex.landing.openHandoff": {
          "type": "string",
          "enum": [
            "no",
            "ask",
            "yes"
          ],
          "default": "yes",
          "description": "After Receive, open qualified Handoff artifacts (never pointer files). The optional tiinex.operator.role text prefers endpoint matches; when it matches none, all qualified Handoffs are eligible."
        }
      }
    },
    "views": {
      "tiinex": [
        {
          "id": "tiinex.operator",
          "name": "Tiinex Operator",
          "type": "webview",
          "visibility": "visible"
        }
      ]
    },
    "menus": {
      "editor/context": [
        {
          "command": "tiinex.createHandoffFromArtifact",
          "when": "tiinex.activeArtifactCanCreateHandoff && editorLangId == markdown",
          "group": "navigation@70"
        }
      ],
      "editor/title/context": [
        {
          "command": "tiinex.createHandoffFromArtifact",
          "when": "tiinex.activeArtifactCanCreateHandoff && editorLangId == markdown",
          "group": "navigation@70"
        }
      ],
      "view/title": [
        {
          "command": "tiinex.refreshDiagnostics",
          "when": "view == tiinex.operator",
          "group": "navigation@10"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "tiinex",
          "title": "Tiinex",
          "icon": "media/tiinex.svg"
        }
      ]
    }
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node test/run.mjs",
    "vsix": "npm run build && node scripts/package-vsix.mjs",
    "validate": "npm run typecheck && npm test && npm run vsix",
    "dev:build": "tsc -p tsconfig.json && node scripts/dev-signal-reload.mjs",
    "dev:link": "node scripts/dev-link-extension.mjs",
    "dev:unlink": "node scripts/dev-link-extension.mjs --unlink",
    "dev:setup": "tsc -p tsconfig.json && node scripts/dev-link-extension.mjs"
  },
  "dependencies": {
    "@tiinex/core": "0.1.1"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/vscode": "1.95.0",
    "typescript": "5.7.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tiinex/extension-vscode.git"
  }
}
