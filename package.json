{
  "name": "tiinex-vscode",
  "displayName": "Tiinex",
  "description": "Thin native VS Code operator bridge for qualified Tiinex validation, artifact-first Handoff authoring, package construction, Workspace landing, and Git workflow.",
  "version": "0.1.7",
  "publisher": "tiinex",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:tiinex.landHandoffPackage",
    "onCommand:tiinex.generateCommitMessage",
    "onCommand:tiinex.stageCommitPush",
    "workspaceContains:.topics",
    "onCommand:tiinex.createHandoff",
    "onCommand:tiinex.buildHandoffPackage",
    "onStartupFinished",
    "onLanguage:markdown",
    "onCommand:tiinex.openOperator",
    "onCommand:tiinex.refreshDiagnostics",
    "onCommand:tiinex.showProblems",
    "onCommand:tiinex.createHandoffFromArtifact",
    "onView:tiinex.discovery",
    "onView:tiinex.incoming",
    "onView:tiinex.outgoing",
    "onCommand:tiinex.discovery.selectFolder",
    "onCommand:tiinex.outgoing.new",
    "onCommand:tiinex.outgoing.bumpMajor",
    "onCommand:tiinex.outgoing.clearMajor",
    "onCommand:tiinex.incoming.refresh",
    "onCommand:tiinex.incoming.close",
    "onCommand:tiinex.incoming.mergeReplace",
    "onCommand:tiinex.outgoing.selectWorkspaces",
    "onCommand:tiinex.outgoing.refresh",
    "onCommand:tiinex.outgoing.close",
    "onCommand:tiinex.incoming.merge",
    "onCommand:tiinex.incoming.replace",
    "onCommand:tiinex.outgoing.selectFolder",
    "onCommand:tiinex.artifact.newHandoff",
    "onCommand:tiinex.artifact.attachHandoff",
    "onCommand:tiinex.outgoing.attachHandoff",
    "onCommand:tiinex.outgoing.detachHandoff"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "tiinex.outgoing.refresh",
        "title": "Tiinex: Refresh Outgoing",
        "icon": "$(refresh)"
      },
      {
        "command": "tiinex.outgoing.close",
        "title": "Tiinex: Close Outgoing",
        "icon": "$(close)"
      },
      {
        "command": "tiinex.outgoing.selectWorkspaces",
        "title": "Tiinex: Select Outgoing Workspaces",
        "icon": "$(list-selection)"
      },
      {
        "command": "tiinex.outgoing.new",
        "title": "Tiinex: New Outgoing",
        "icon": "$(add)"
      },
      {
        "command": "tiinex.incoming.refresh",
        "title": "Tiinex: Refresh Incoming",
        "icon": "$(refresh)"
      },
      {
        "command": "tiinex.incoming.close",
        "title": "Tiinex: Close Incoming Package",
        "icon": "$(close)"
      },
      {
        "command": "tiinex.incoming.mergeReplace",
        "title": "Tiinex: Merge / Replace Incoming",
        "icon": "$(git-merge)"
      },
      {
        "command": "tiinex.outgoing.clearMajor",
        "title": "Tiinex: Use Child Carrier Lineage",
        "icon": "$(arrow-down)"
      },
      {
        "command": "tiinex.outgoing.bumpMajor",
        "title": "Tiinex: Bump Outgoing Carrier Major",
        "icon": "$(arrow-up)"
      },
      {
        "command": "tiinex.discovery.selectFolder",
        "title": "Tiinex: Select Discovery Folder",
        "icon": "$(folder-opened)"
      },
      {
        "command": "tiinex.discovery.refresh",
        "title": "Tiinex: Refresh Discovery",
        "icon": "$(refresh)"
      },
      {
        "command": "tiinex.discovery.toggleProjection",
        "title": "Tiinex: Toggle Discovery Logical / Files",
        "icon": "$(list-tree)"
      },
      {
        "command": "tiinex.discovery.toggleLineage",
        "title": "Tiinex: Toggle Discovery Leaves / Lineage",
        "icon": "$(references)"
      },
      {
        "command": "tiinex.discovery.toggleDelta",
        "title": "Tiinex: Toggle Discovery All / Delta",
        "icon": "$(diff)"
      },
      {
        "command": "tiinex.discovery.setIncoming",
        "title": "Tiinex: Set as Incoming",
        "icon": "$(arrow-down)"
      },
      {
        "command": "tiinex.incoming.toggleProjection",
        "title": "Tiinex: Toggle Incoming Logical / Files",
        "icon": "$(list-tree)"
      },
      {
        "command": "tiinex.incoming.toggleLineage",
        "title": "Tiinex: Toggle Incoming Leaves / Lineage",
        "icon": "$(references)"
      },
      {
        "command": "tiinex.incoming.toggleDelta",
        "title": "Tiinex: Toggle Incoming All / Delta",
        "icon": "$(diff)"
      },
      {
        "command": "tiinex.outgoing.toggleProjection",
        "title": "Tiinex: Toggle Outgoing Logical / Files",
        "icon": "$(list-tree)"
      },
      {
        "command": "tiinex.outgoing.toggleLineage",
        "title": "Tiinex: Toggle Outgoing Leaves / Lineage",
        "icon": "$(references)"
      },
      {
        "command": "tiinex.outgoing.newHandoff",
        "title": "Tiinex: New Handoff",
        "icon": "$(add)"
      },
      {
        "command": "tiinex.outgoing.previewDraft",
        "title": "Tiinex: Preview Handoff Draft",
        "icon": "$(preview)"
      },
      {
        "command": "tiinex.outgoing.writeDraft",
        "title": "Tiinex: Write Reviewed Handoff",
        "icon": "$(save)"
      },
      {
        "command": "tiinex.outgoing.excludeRoute",
        "title": "Tiinex: Exclude Handoff Route",
        "icon": "$(unlink)"
      },
      {
        "command": "tiinex.outgoing.includeRoute",
        "title": "Tiinex: Include Handoff Route",
        "icon": "$(link)"
      },
      {
        "command": "tiinex.outgoing.package",
        "title": "Pack",
        "icon": "$(package)"
      },
      {
        "command": "tiinex.outgoing.omitWorkspacePayload",
        "title": "Tiinex: Use Checkout Instead of Workspace ZIP",
        "icon": "$(cloud-download)"
      },
      {
        "command": "tiinex.outgoing.embedWorkspacePayload",
        "title": "Tiinex: Embed Workspace Payload ZIP",
        "icon": "$(file-zip)"
      },
      {
        "command": "tiinex.outgoing.omitBootstrapPayload",
        "title": "Tiinex: Omit Bootstrap Payload ZIP",
        "icon": "$(cloud)"
      },
      {
        "command": "tiinex.outgoing.embedBootstrapPayload",
        "title": "Tiinex: Include Bootstrap Payload ZIP",
        "icon": "$(file-zip)"
      },
      {
        "command": "tiinex.createHandoffFromArtifact",
        "title": "Tiinex: Create Handoff from This Artifact",
        "enablement": "tiinex.activeArtifactCanCreateHandoff"
      },
      {
        "command": "tiinex.landHandoffPackage",
        "title": "Tiinex: Open Handoff Package as Incoming"
      },
      {
        "command": "tiinex.buildHandoffPackage",
        "title": "Tiinex: Package Outgoing"
      },
      {
        "command": "tiinex.createHandoff",
        "title": "Tiinex: New Outgoing Handoff"
      },
      {
        "command": "tiinex.refreshDiagnostics",
        "title": "Tiinex: Refresh Validation"
      },
      {
        "command": "tiinex.stageCommitPush",
        "title": "Tiinex: Stage, Commit & Push with Tiinex"
      },
      {
        "command": "tiinex.generateCommitMessage",
        "title": "Tiinex: Generate Tiinex Commit Message"
      },
      {
        "command": "tiinex.openOperator",
        "title": "Tiinex: Open Operator"
      },
      {
        "command": "tiinex.showProblems",
        "title": "Tiinex: Show Validation Problems"
      },
      {
        "command": "tiinex.incoming.merge",
        "title": "Merge",
        "icon": "$(git-merge)"
      },
      {
        "command": "tiinex.incoming.replace",
        "title": "Replace",
        "icon": "$(replace-all)"
      },
      {
        "command": "tiinex.outgoing.selectFolder",
        "title": "Tiinex: Select Outgoing Folder",
        "icon": "$(folder-opened)"
      },
      {
        "command": "tiinex.artifact.newHandoff",
        "title": "New Handoff"
      },
      {
        "command": "tiinex.artifact.attachHandoff",
        "title": "Attach Handoff to Outgoing",
        "icon": "$(link)"
      },
      {
        "command": "tiinex.outgoing.attachHandoff",
        "title": "Attach Handoff to Outgoing",
        "icon": "$(link)"
      },
      {
        "command": "tiinex.outgoing.detachHandoff",
        "title": "Detach Handoff from Outgoing",
        "icon": "$(unlink)"
      },
      {
        "command": "tiinex.outgoing.copyTransportText",
        "title": "Copy Handoff Transport Text",
        "icon": "$(copy)"
      }
    ],
    "configuration": {
      "title": "Tiinex",
      "properties": {
        "tiinex.discovery.folder": {
          "type": "string",
          "default": "",
          "description": "Folder containing .handoff-package.zip carriers shown by Discovery. Blank means no discovery folder; expanding Discovery asks you to choose one."
        },
        "tiinex.discovery.autoRefresh": {
          "type": "boolean",
          "default": false,
          "description": "Automatically refresh the Discovery tree when .handoff-package.zip files change in the selected discovery folder. This never performs Receive/landing."
        },
        "tiinex.discovery.latestToIncoming": {
          "type": "boolean",
          "default": false,
          "description": "When Discovery finds a new latest carrier, set that carrier as Incoming after qualification. This never performs Receive/landing."
        },
        "tiinex.incoming.autoShowRoleHandoff": {
          "type": "string",
          "enum": [
            "no",
            "ask",
            "yes"
          ],
          "default": "ask",
          "description": "When Incoming has one or more qualified Handoff routes whose To matches tiinex.operator.role, optionally preview and reveal every matching actual Handoff. The Handoff is selected in the Incoming tree with its ancestors expanded; transport pointers remain separate provenance nodes."
        },
        "tiinex.operator.role": {
          "type": "string",
          "default": "",
          "description": "Operator role label used only for UI defaults and exact role-matched Handoff preview (for example Sigma). It does not grant Role authority."
        },
        "tiinex.nodePath": {
          "type": "string",
          "default": "",
          "description": "Optional Node executable override for Tiinex Tooling. Blank uses the current executable when it is Node; otherwise it uses node/node.exe from PATH."
        },
        "tiinex.landing.commit": {
          "type": "string",
          "enum": [
            "no",
            "ask",
            "yes"
          ],
          "default": "no",
          "description": "After successful Incoming Workspace merges that were staged by Tiinex, Yes commits the staged changes, Ask asks after all selected merges finish, and No leaves them staged with a trusted commit message available."
        },
        "tiinex.landing.push": {
          "type": "string",
          "enum": [
            "no",
            "ask",
            "yes"
          ],
          "default": "no",
          "description": "Push only a commit created by the same explicit Merge invocation after staging and commit were approved. Manual commits and unstaged Receive results are never auto-pushed."
        },
        "tiinex.landing.stage": {
          "type": "string",
          "enum": [
            "no",
            "yes"
          ],
          "default": "yes",
          "description": "After a successful explicit Incoming Workspace merge, stage safe landed changes. No leaves the landed changes unstaged and therefore suppresses extension-driven commit/push for that merge."
        },
        "tiinex.outgoing.folder": {
          "type": "string",
          "default": "",
          "description": "Folder where Pack writes materialized Outgoing .handoff-package.zip carriers. Blank asks for a folder when Pack is used."
        }
      }
    },
    "views": {
      "tiinex": [
        {
          "id": "tiinex.discovery",
          "name": "Discovery",
          "visibility": "visible"
        },
        {
          "id": "tiinex.incoming",
          "name": "Incoming",
          "visibility": "visible"
        },
        {
          "id": "tiinex.outgoing",
          "name": "Outgoing",
          "visibility": "visible"
        }
      ]
    },
    "menus": {
      "editor/context": [
        {
          "command": "tiinex.createHandoffFromArtifact",
          "when": "tiinex.activeArtifactCanCreateHandoff && editorLangId == markdown",
          "group": "navigation@70"
        }
      ],
      "editor/title/context": [
        {
          "command": "tiinex.createHandoffFromArtifact",
          "when": "tiinex.activeArtifactCanCreateHandoff && editorLangId == markdown",
          "group": "navigation@70"
        }
      ],
      "view/title": [
        {
          "command": "tiinex.discovery.toggleProjection",
          "when": "view == tiinex.discovery && tiinex.discovery.hasPackages",
          "group": "navigation@5"
        },
        {
          "command": "tiinex.discovery.toggleLineage",
          "when": "view == tiinex.discovery && tiinex.discovery.hasPackages",
          "group": "navigation@6"
        },
        {
          "command": "tiinex.discovery.toggleDelta",
          "when": "view == tiinex.discovery",
          "group": "navigation@4"
        },
        {
          "command": "tiinex.discovery.selectFolder",
          "when": "view == tiinex.discovery",
          "group": "navigation@7"
        },
        {
          "command": "tiinex.discovery.refresh",
          "when": "view == tiinex.discovery",
          "group": "navigation@9"
        },
        {
          "command": "tiinex.incoming.toggleProjection",
          "when": "view == tiinex.incoming && tiinex.incoming.hasPackage",
          "group": "navigation@5"
        },
        {
          "command": "tiinex.incoming.toggleLineage",
          "when": "view == tiinex.incoming && tiinex.incoming.hasPackage",
          "group": "navigation@6"
        },
        {
          "command": "tiinex.incoming.toggleDelta",
          "when": "view == tiinex.incoming",
          "group": "navigation@4"
        },
        {
          "command": "tiinex.incoming.refresh",
          "when": "view == tiinex.incoming",
          "group": "navigation@9"
        },
        {
          "command": "tiinex.outgoing.new",
          "when": "view == tiinex.outgoing",
          "group": "navigation@1"
        },
        {
          "command": "tiinex.outgoing.selectWorkspaces",
          "when": "view == tiinex.outgoing && tiinex.outgoing.hasContext",
          "group": "navigation@2"
        },
        {
          "command": "tiinex.outgoing.bumpMajor",
          "when": "view == tiinex.outgoing && tiinex.outgoing.canBumpMajor",
          "group": "navigation@3"
        },
        {
          "command": "tiinex.outgoing.clearMajor",
          "when": "view == tiinex.outgoing && tiinex.outgoing.majorSelected",
          "group": "navigation@3"
        },
        {
          "command": "tiinex.outgoing.toggleProjection",
          "when": "view == tiinex.outgoing && tiinex.outgoing.hasContext",
          "group": "navigation@5"
        },
        {
          "command": "tiinex.outgoing.toggleLineage",
          "when": "view == tiinex.outgoing && tiinex.outgoing.hasContext",
          "group": "navigation@6"
        },
        {
          "command": "tiinex.outgoing.selectFolder",
          "when": "view == tiinex.outgoing",
          "group": "navigation@7"
        },
        {
          "command": "tiinex.outgoing.refresh",
          "when": "view == tiinex.outgoing",
          "group": "navigation@9"
        }
      ],
      "view/item/context": [
        {
          "command": "tiinex.discovery.setIncoming",
          "when": "view == tiinex.discovery && viewItem == tiinex.discoveryPackage",
          "group": "inline@1"
        },
        {
          "command": "tiinex.incoming.merge",
          "when": "view == tiinex.incoming && (viewItem == tiinex.incomingPackage || viewItem == tiinex.incomingWorkspace || viewItem == tiinex.incomingWorkspaceArchive)",
          "group": "inline@1"
        },
        {
          "command": "tiinex.incoming.replace",
          "when": "view == tiinex.incoming && (viewItem == tiinex.incomingPackage || viewItem == tiinex.incomingWorkspace || viewItem == tiinex.incomingWorkspaceArchive)",
          "group": "inline@2"
        },
        {
          "command": "tiinex.incoming.close",
          "when": "view == tiinex.incoming && (viewItem == tiinex.incomingPackage || viewItem == tiinex.incomingPackageLoading)",
          "group": "inline@9"
        },
        {
          "command": "tiinex.outgoing.package",
          "when": "view == tiinex.outgoing && viewItem == tiinex.outgoingRoot",
          "group": "inline@1"
        },
        {
          "command": "tiinex.outgoing.close",
          "when": "view == tiinex.outgoing && viewItem == tiinex.outgoingRoot",
          "group": "inline@9"
        },
        {
          "command": "tiinex.outgoing.newHandoff",
          "when": "view == tiinex.outgoing && (viewItem == tiinex.outgoingWorkspace || viewItem == tiinex.outgoingWorkspaceArchive)",
          "group": "inline@1"
        },
        {
          "command": "tiinex.outgoing.writeDraft",
          "when": "view == tiinex.outgoing && viewItem == tiinex.outgoingDraft",
          "group": "inline@1"
        },
        {
          "command": "tiinex.outgoing.includeRoute",
          "when": "view == tiinex.outgoing && viewItem == tiinex.outgoingDraftWritten",
          "group": "inline@2"
        },
        {
          "command": "tiinex.outgoing.excludeRoute",
          "when": "view == tiinex.outgoing && viewItem == tiinex.outgoingDraftRoute",
          "group": "inline@2"
        },
        {
          "command": "tiinex.outgoing.attachHandoff",
          "when": "view == tiinex.outgoing && viewItem == tiinex.outgoingHandoffUnattached",
          "group": "inline@2"
        },
        {
          "command": "tiinex.outgoing.copyTransportText",
          "when": "view == tiinex.outgoing && viewItem == tiinex.outgoingHandoffAttached",
          "group": "inline@1"
        },
        {
          "command": "tiinex.outgoing.detachHandoff",
          "when": "view == tiinex.outgoing && viewItem == tiinex.outgoingHandoffAttached",
          "group": "inline@2"
        },
        {
          "command": "tiinex.outgoing.omitWorkspacePayload",
          "when": "view == tiinex.outgoing && viewItem == tiinex.outgoingWorkspaceDescriptorEmbedded",
          "group": "inline@1"
        },
        {
          "command": "tiinex.outgoing.embedWorkspacePayload",
          "when": "view == tiinex.outgoing && viewItem == tiinex.outgoingWorkspaceDescriptorCheckout",
          "group": "inline@1"
        },
        {
          "command": "tiinex.outgoing.omitBootstrapPayload",
          "when": "view == tiinex.outgoing && viewItem == tiinex.outgoingBootstrapDescriptorEmbedded",
          "group": "inline@1"
        },
        {
          "command": "tiinex.outgoing.embedBootstrapPayload",
          "when": "view == tiinex.outgoing && viewItem == tiinex.outgoingBootstrapDescriptorOmitted",
          "group": "inline@1"
        }
      ],
      "commandPalette": [
        {
          "command": "tiinex.discovery.setIncoming",
          "when": "false"
        },
        {
          "command": "tiinex.incoming.close",
          "when": "false"
        },
        {
          "command": "tiinex.incoming.mergeReplace",
          "when": "false"
        },
        {
          "command": "tiinex.incoming.merge",
          "when": "false"
        },
        {
          "command": "tiinex.incoming.replace",
          "when": "false"
        },
        {
          "command": "tiinex.outgoing.close",
          "when": "false"
        },
        {
          "command": "tiinex.outgoing.excludeRoute",
          "when": "false"
        },
        {
          "command": "tiinex.outgoing.includeRoute",
          "when": "false"
        },
        {
          "command": "tiinex.outgoing.newHandoff",
          "when": "false"
        },
        {
          "command": "tiinex.outgoing.previewDraft",
          "when": "false"
        },
        {
          "command": "tiinex.outgoing.writeDraft",
          "when": "false"
        },
        {
          "command": "tiinex.outgoing.omitWorkspacePayload",
          "when": "false"
        },
        {
          "command": "tiinex.outgoing.embedWorkspacePayload",
          "when": "false"
        },
        {
          "command": "tiinex.outgoing.omitBootstrapPayload",
          "when": "false"
        },
        {
          "command": "tiinex.outgoing.embedBootstrapPayload",
          "when": "false"
        },
        {
          "command": "tiinex.outgoing.selectFolder",
          "when": "false"
        },
        {
          "command": "tiinex.outgoing.attachHandoff",
          "when": "false"
        },
        {
          "command": "tiinex.outgoing.detachHandoff",
          "when": "false"
        },
        {
          "command": "tiinex.artifact.newHandoff",
          "when": "false"
        },
        {
          "command": "tiinex.artifact.attachHandoff",
          "when": "false"
        },
        {
          "command": "tiinex.outgoing.copyTransportText",
          "when": "false"
        }
      ],
      "explorer/context": [
        {
          "submenu": "tiinex.explorer.actions",
          "when": "resourceScheme == file",
          "group": "1_tiinex@1"
        }
      ],
      "tiinex.explorer.actions": [
        {
          "command": "tiinex.artifact.newHandoff",
          "when": "explorerResourceIsFolder",
          "group": "1_authoring@1"
        },
        {
          "command": "tiinex.artifact.attachHandoff",
          "when": "!explorerResourceIsFolder && resourceExtname == .md",
          "group": "1_authoring@2"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "tiinex",
          "title": "Tiinex",
          "icon": "media/tiinex.svg"
        }
      ]
    },
    "submenus": [
      {
        "id": "tiinex.explorer.actions",
        "label": "Tiinex"
      }
    ]
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node test/run.mjs",
    "vsix": "npm run build && node scripts/package-vsix.mjs",
    "validate": "npm run typecheck && npm test && npm run vsix",
    "dev:build": "npm run build",
    "dev:setup": "npm run dev:link",
    "dev:link": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/ensure-windows-main-host-dev-extension-link.ps1",
    "dev:unlink": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/ensure-windows-main-host-dev-extension-link.ps1 -Unlink"
  },
  "dependencies": {
    "@tiinex/core": "^0.6.0"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/vscode": "1.95.0",
    "typescript": "5.7.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tiinex/extension-vscode.git"
  }
}
